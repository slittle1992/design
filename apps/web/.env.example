# Google Maps Platform key for satellite tiles + geocoding.
# Get one at https://console.cloud.google.com/google/maps-apis/credentials
# Recommended restrictions:
#   - HTTP referrer restriction (your dev + prod domains) on the public key
#   - IP restriction on the server-only key
#   - APIs enabled: Geocoding API, Maps Static API
GOOGLE_MAPS_API_KEY=your_server_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_public_key_here
